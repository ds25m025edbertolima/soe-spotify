# PostgreSQL Configuration
# DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS

# ============================================
# Option 1: Local PostgreSQL (Development)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soe_spotify

# ============================================
# Option 2: Supabase Cloud (Production)
# ============================================
# 1. Create project at https://app.supabase.com
# 2. Get connection string from Settings → Database → Connection String
# 3. Replace [PASSWORD] and [PROJECT_ID] below
# 4. Copy entire URL to DATABASE_URL variable

# Supabase Connection String Format:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT_ID].supabase.co:5432/postgres

# Example (DO NOT USE - REPLACE WITH YOUR VALUES):
# DATABASE_URL=postgresql://postgres:your_supabase_password_here@project_id.supabase.co:5432/postgres

# ============================================
# API Keys (Optional - for direct API calls)
# ============================================
# Get from Settings → API
# SUPABASE_ANON_KEY=sb_anon_key_here
# SUPABASE_SERVICE_KEY=sb_service_key_here
